{
  "name": "dsh-sidebar-memo",
  "version": "0.1.0",
  "private": true,
  "description": "右侧边栏的备忘录：与模型共写的待办清单和每日日记，可上传到 note.ms / getnote.top。",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memo",
    "todo",
    "diary",
    "sidebar"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "icon.png",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
